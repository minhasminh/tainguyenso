# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# CẤU HÌNH SUPABASE CHO PRODUCTION:
# LƯU Ý QUAN TRỌNG:
# 1. Các biến có tiền tố VITE_* được Vite nhúng vào mã nguồn tại THỜI ĐIỂM BUILD (npm run build).
#    Khi thay đổi hoặc cập nhật giá trị biến, BẮT BUỘC phải chạy "npm run build" lại và deploy lại thư mục dist.
# 2. Hỗ trợ 2 định dạng khóa công khai an toàn cho Frontend:
#    - Legacy anon key (bắt đầu bằng eyJ...)
#    - Supabase Publishable key (bắt đầu bằng sb_publishable_...)
# 3. TUYỆT ĐỐI KHÔNG commit file .env chứa key thực tế vào Git/GitHub.
# 4. TUYỆT ĐỐI KHÔNG sử dụng SUPABASE_SERVICE_ROLE_KEY hoặc sb_secret_... trong frontend.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_ag2fAQNwcqZYOCi9PKV8Jg_NuiBs7rD

